{
  "name": "@sponcer/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "model:prefetch": "tsx --env-file-if-exists=.env src/modules/classification/scripts/prefetch-model.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@sponcer/contracts": "*",
    "@supabase/supabase-js": "^2.119.2",
    "apify-client": "^2.26.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.9.0",
    "supertest": "^7.3.2"
  }
}
