# mock | real (por defecto mock)
ADAPTER_AUTH=mock
ADAPTER_PROFILES=mock
ADAPTER_INGESTION=mock
ADAPTER_CLASSIFICATION=mock
ADAPTER_MATCHING=mock
ADAPTER_QUOTES=mock
ADAPTER_NOTIFICATIONS=mock
ADAPTER_CHAT=mock
