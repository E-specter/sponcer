---
import { PUBLIC_AUTH_MODE } from 'astro:env/client';
import Base from './Base.astro';
import { getMe } from '../lib/session';
import ProfileSwitcher from '../features/profiles/islands/ProfileSwitcher';
import NotificationsBell from '../features/notifications/islands/NotificationsBell';

interface Props {
  title: string;
}

const me = await getMe(Astro.locals);
const path = Astro.url.pathname;
const links = [
  { href: '/descubrir', label: 'Descubrir' },
  { href: '/panel', label: 'Mi panel' },
  { href: '/panel/matches', label: 'Matches' },
  { href: '/panel/cotizaciones', label: 'Cotizaciones' },
];
---

<Base title={Astro.props.title}>
  <header class="site-header">
    <div class="container">
      <a class="brand" href="/descubrir">Sponcer</a>
      <nav aria-label="Principal">
        {
          links.map((l) => (
            <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <ProfileSwitcher client:load profiles={me.profiles} />
      <NotificationsBell client:idle />
      {
        PUBLIC_AUTH_MODE === 'supabase' && (
          <form method="post" action="/auth/logout">
            <button class="btn btn-secondary" type="submit">Salir</button>
          </form>
        )
      }
    </div>
  </header>
  <main id="contenido" class="container stack">
    <slot />
  </main>
</Base>
