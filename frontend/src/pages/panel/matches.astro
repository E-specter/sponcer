---
import App from '../../layouts/App.astro';
import { call } from '../../lib/api';
import { getMe } from '../../lib/session';
import MatchList from '../../features/matches/islands/MatchList';

const me = await getMe(Astro.locals);
const token = Astro.locals.accessToken;
const sections = await Promise.all(
  me.profiles.map(async (profile) => ({
    profile,
    matches: await call('matches', { query: { profileId: profile.id }, token }),
  })),
);
---

<App title="Matches">
  <header class="page-head">
    <p class="eyebrow">Tu espacio / matches</p>
    <h1>Matches</h1>
    <p class="lead">Intereses mutuos: aquí puedes abrir el chat.</p>
  </header>
  {me.profiles.length === 0 && <p class="card">Reclama un perfil en <a href="/panel">Mi panel</a> para empezar.</p>}
  {
    sections.map(({ profile, matches }) => (
      <section class="stack" aria-labelledby={`s-${profile.id}`}>
        <h2 id={`s-${profile.id}`}>@{profile.handle}</h2>
        <MatchList client:load profileId={profile.id} initial={matches.items} nextCursor={matches.nextCursor} />
      </section>
    ))
  }
</App>
