# Volver a modo local sin backend ni Supabase: PUBLIC_API_MODE=mock y PUBLIC_AUTH_MODE=mock.
# Modo integrado: PUBLIC_API_MODE=http y PUBLIC_AUTH_MODE=supabase (requiere core API y Supabase local).
# mock = datos en memoria (sin backend) | http = core API
PUBLIC_API_MODE=mock
PUBLIC_API_URL=http://localhost:3000
# mock = sesión demo | supabase = enlace mágico (requiere las dos variables de abajo)
PUBLIC_AUTH_MODE=mock
# Necesarios con PUBLIC_AUTH_MODE=supabase (auth y Realtime de lectura). Nunca pongas secretos aquí.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Demo pública (ADR-007): con PUBLIC_DEMO_LOGIN=true y DEMO_PASSWORD definido, /login ofrece cuentas *@sponcer.local.
# DEMO_PASSWORD es un secreto de servidor: no lo pongas en el cliente ni lo versiones.
PUBLIC_DEMO_LOGIN=false
DEMO_PASSWORD=

# Origen público cuando hay un túnel/proxy (ADR-007), p. ej. https://x.trycloudflare.com: lo acepta la protección CSRF,
# fija las cookies Secure y las URL absolutas (enlace mágico). Vacío = el origen de la petición.
PUBLIC_SITE_URL=
